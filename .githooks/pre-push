#!/bin/sh
# A shell file changed without a VERSION bump fails here, in a second, not
# in the Deploy job after the wait. Turn on once:
#   git config core.hooksPath .githooks
py=python3; command -v python3 >/dev/null 2>&1 || py=python
base=$(git rev-parse --verify -q @{upstream} 2>/dev/null || echo HEAD~1)
$py scripts/check_shell.py "$base"
